{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "ignoreDeps": [
    // grc.store accepts results only when publish.yml is called by its v1 tag,
    // so it must not be pinned to a digest (see publish-to-grc-store.yml).
    "revanite-io/pvtr-publish-results"
  ],
  "labels": ["dependencies", "renovate"],
  "prConcurrentLimit": 15, 
  "packageRules": [
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor","patch"],
      "matchCurrentVersion": "!/^v?0/",
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    },
    {
      "matchPackageNames": ["github.com/coredns/caddy"],
      "allowedVersions": "!/^v?2/",
      "enabled": false
    },
    {
      "matchDepTypes": ["action"],
      "pinDigests": true
    }
  ]
}
